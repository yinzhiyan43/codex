{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "protocol-adapter/**/*.ts",
    "desktop-host/**/*.ts",
    "tests/**/*.ts",
    "desktop/**/*.ts",
    "ui/**/*.ts",
    "domain/**/*.ts"
  ]
}
