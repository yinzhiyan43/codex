{
  "name": "@yinzhiyan43/codex-workbench-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "check": "npm run contracts:check && npm run typecheck && npm test",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .desktop/main.mjs",
    "desktop:smoke": "npm run desktop:build && electron .desktop/main.mjs --smoke-output",
    "core:check": "node --test tests/real-core/official.test.ts",
    "desktop:core": "npm run desktop:build && electron .desktop/main.mjs --official-core",
    "desktop:core:smoke": "npm run desktop:build && electron .desktop/main.mjs --official-core --smoke-output",
    "desktop:account": "npm run desktop:build && electron .desktop/main.mjs --official-account",
    "official:status": "node scripts/official-model-smoke.mjs",
    "official:model:smoke": "node scripts/official-model-smoke.mjs --run-model-smoke",
    "desktop:account:smoke": "npm run desktop:build && electron .desktop/main.mjs --official-account --smoke-output",
    "desktop:chat": "npm run desktop:build && electron .desktop/main.mjs --official-chat",
    "desktop:chat:smoke": "npm run desktop:build && electron .desktop/main.mjs --official-chat-offline --smoke-output",
    "desktop:history:smoke": "npm run desktop:build && electron .desktop/main.mjs --official-chat-offline --history-smoke --smoke-output",
    "history:core:check": "node scripts/history-core-check.mjs",
    "persistence:core:check": "node scripts/persistent-core-check.mjs",
    "desktop:persistence:smoke": "npm run desktop:build && node scripts/persistence-ui-check.mjs",
    "management:core:check": "node scripts/session-management-core-check.mjs",
    "desktop:management:smoke": "npm run desktop:build && node scripts/session-management-ui-check.mjs",
    "editing:core:check": "node scripts/session-editing-core-check.mjs",
    "desktop:editing:smoke": "npm run desktop:build && node scripts/session-editing-ui-check.mjs",
    "concurrency:core:check": "node scripts/session-concurrency-core-check.mjs",
    "desktop:copy:smoke": "npm run desktop:build && node scripts/session-copy-ui-check.mjs",
    "desktop:settings:smoke": "npm run desktop:build && node scripts/sidebar-settings-ui-check.mjs",
    "desktop:window:smoke": "npm run desktop:build && node scripts/session-window-ui-check.mjs",
    "desktop:search:smoke": "npm run desktop:build && node scripts/session-search-ui-check.mjs",
    "search:core:check": "node scripts/session-search-core-check.mjs",
    "desktop:theme:smoke": "npm run desktop:build && node scripts/session-theme-ui-check.mjs",
    "desktop:keyboard:smoke": "npm run desktop:build && node scripts/keyboard-ui-check.mjs",
    "desktop:editable:smoke": "npm run desktop:build && node scripts/editable-ui-check.mjs"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
